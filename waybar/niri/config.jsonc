{ "reload_style_on_change": true,
    "layer": "top", 
    "position": "top",

    "modules-left": [
        "group/menu-updates",
        "niri/workspaces",
    ],

    "modules-center": [
    ],

    "modules-right": [
        "backlight",
        "group/sound",
        "battery",
        "group/cpu-temp",
        "memory",
        "tray",
        "niri/language",
        "clock",
    ],

    "niri/language": {
        "format": "<span font_size='11pt'>{}</span>",
        "format-en": "en",
        "format-ru": "ru",
    },

    "niri/workspaces": {
        "format": "<span font_size='10pt'>{name}</span>",
    },

    "niri/window": {
        "format": "{title}",
    },

    "keyboard-state": {
        "numlock": true,
        "capslock": false,
        "format": "{name} {icon}",
        "format-icons": {
            "locked": "",
            "unlocked": ""
        }
    },

    "tray": {
        "icon-size": 15,
        "spacing": 20,
    },

    "clock": {
        "format": "<span font_size='11pt'>{:%H:%M}</span>",
        "format-alt": "{:%A, %B %d, %Y (%R)}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode"          : "year",
            "mode-mon-col"  : 3,
            "weeks-pos"     : "right",
            "on-scroll"     : 1,
            "format": {
                "months":     "<span color='#a67e9e'><b>{}</b></span>",
                "days":       "<span color='#5e3394'><b>{}</b></span>",
                "weeks":      "<span color='#4c2679'><b>W{}</b></span>",
                "weekdays":   "<span color='#caa94f'><b>{}</b></span>",
                "today":      "<span color='#b64444'><b><u>{}</u></b></span>"
            }
        },
        "actions":  {
            "on-click-right": "mode",
            "on-scroll-up": "tz_up",
            "on-scroll-down": "tz_down",
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        }
    },
    "cpu": {
        "format": "<span font_size='15pt'></span><span font_size='7pt'>{usage}%</span>",
        "tooltip": true
    },
    "memory": {
        "format": "<span font_size='15pt'></span><span font_size='7pt'>{}%</span>",
        "tooltip": true
    },
    "temperature": {
        "thermal-zone": 2,
        "hwmon-path": "/sys/class/hwmon/hwmon1/temp1_input",
        "critical-threshold": 80,
        "format-critical": "<span font_size='12pt'>{icon}</span><span font_size='7pt'>{temperatureC}󰔄</span>",
        "format": "<span font_size='15pt'>{icon}</span><span font_size='7pt'>{temperatureC}󰔄</span>",
        "format-icons": ["", "", ""],
        "tooltip": false
    },
    "backlight": {
        // "device": "acpi_video1",
        "format": "<span font_size='15pt'>{icon}</span><span font_size='7pt'>{percent}%</span>",
        "format-icons": ["", "", "", "", "", "", "", "", ""],
        "tooltip": true,
        "tooltip-format": "Backlight"
    },
    "battery": {
        "states": {
            "good": 100,
            "normal": 95,
            "warning": 49,
            "critical": 20
        },
        "format": "<span font_size='15pt'>{icon}</span><span font_size='7pt'>{capacity}%</span>",
        "format-plugged": "",
        "format-good": "", 
        "format-full": "",
        "format-icons": ["", "", "", "", ""]
    },

    "network": {
        // "interface": "wlp2*", // (Optional) To force the use of this interface
        "format-icons": ["󰤟", "󰤢", "󰤥", "󰤨"],
        "format-wifi": "<span font_size='15pt'>{icon}</span><span font_size='7pt'>{signalStrength}%</span>",
        "format-ethernet": " ",
        "tooltip-format": "{essid}",
        "format-linked": " <small><sub>No IP</sub></small>",
        "format-disconnected": "<big>⚠</big><small><sub>Dwn</sub></small>",
        "on-click": "exec nm-connection-editor"
    },

    "pulseaudio": {
        "format-icons": {
            "default": ["", "", ""]
        },
        "scroll-step": 5, // %, can be a float
        "format": "<span font_size='15pt'>{icon}</span><span font_size='7pt'>{volume}%</span>",
        "format-bluetooth": " <big>{icon}</big>{volume}%",
        "format-bluetooth-muted": " ",
        "format-muted": "<span font_size='15pt'></span><span font_size='7pt'>off</span>",
        // "on-click": "pavucontrol",
        // "on-click-right": "foot -a pw-top pw-top"
    },

    "pulseaudio#mic": {
        "format": "{format_source}",
        "format-source": "<span font_size='15pt'>󰍬</span><span font_size='7pt'>on </span>",
        "format-source-muted": "<span font_size='15pt'>󰍭</span><span font_size='7pt'>off</span>",
    },

    "mpris": {
        "format": "{player_icon} {artist} - {title}",
        "format-paused": "{status_icon} <i>{artist} - {title}</i>",
        "title-len": 100,
        "player-icons": {
            "default": "▶",
        },
        "status-icons": {
            "paused": "⏸"
        },
    },

        "custom/zapret-status": {
            "interval": 5,
            "exec": "$HOME/.config/waybar/zapret-status.sh",
            "return-type": "text",
        "tooltip-format": "zapret service status \nClick to toggle",
        "on-click": "$HOME/.config/waybar/toggle-zapret.sh",
        "format":"<span font_size='7pt'>{text}</span>"
    },

    "custom/menu": {
        // "format" : "<span font_size='15pt'><tt>󰣇</tt></span>",
        "format" : "<span font_size='15pt'><tt>󰇈</tt></span>",
        "tooltip": false,
        "menu": "on-click",
        "menu-file": "$HOME/.config/waybar/menu.xml", 
        "menu-actions": {
            "shutdown": "poweroff",
            "reboot": "reboot",
        }
    },

    "custom/updates": {
        "format": "{} {icon}",
        "return-type": "json",
        "format-icons": {
            "has-updates": "󱍷",
            "updated": ""
        },
        "exec-if": "which waybar-module-pacman-updates",
        "exec": "waybar-module-pacman-updates --no-zero-output" },

    "group/menu-updates": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 200,
            "children-class": "updates",
            "transition-left-to-right": true
        },
        "modules": [
            "custom/menu",
            "custom/updates",
        ]
    },

    "group/cpu-temp": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 200,
            "children-class": "cpu",
            "transition-left-to-right": false
        },
        "modules": [
            "cpu",
            "temperature",
        ]
    },

    "group/network-zapret" : {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 200,
            "children-class": "network",
            "transition-left-to-right": false
        },
        "modules": [
            "network",
            "custom/zapret-status",
        ]
    },

    "group/sound": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 200,
            "children-class": "pulseaudio",
            "transition-left-to-right": false
        },
        "modules": [
            "pulseaudio",
            "pulseaudio#mic",
        ],

    },

}
