
window-rule {
    match at-startup=true app-id="Alacritty" title="btop"
    open-focused true
    default-column-width { proportion 1.0; }
    open-on-workspace "System"
}

window-rule {
    match at-startup=true app-id=r#"^org\.keepassxc\.KeePassXC$"# title=r#".*.kdbx \[Locked\] - KeePassXC"#
    default-column-width { proportion 1.0; }
    open-focused false
    open-on-workspace "System"
}

spawn-sh-at-startup "alacritty msg create-window --title btop --command btop & alacritty & keepassxc &"
