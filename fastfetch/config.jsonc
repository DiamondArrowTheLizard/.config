// Load with --load-config examples/2.jsonc
// Note that you must replace the image path to an existing image to display it.

{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "display": {
        "separator": " ",
    },
    "logo": {
        "type": "small",
        "color": {
            "1": "38;2;187;154;247",
            "2": "38;2;187;154;247",
        },
        "padding": {
            "right": 2,
            "left": 0,
        }
    },
    "modules": [
        {
            "type": "kernel",
            "key": "╭─󰰊",
            "keyColor": "blue"
        },
        {
            "type": "localip",
            "key": "├─󰩟",
            "keyColor": "blue"
        },
        {
            "type": "uptime",
            "key": "├─󰅐",
            "keyColor": "green"
        },
        {
            "type": "cpu",
            "key": "├─",
            "keyColor": "green"
        },
        {
            "type": "memory",
            "key": "├─",
            "keyColor": "green"
        },
        {
            "type": "shell",
            "key": "├─",
            "keyColor": "yellow"
        },
        {
            "type": "terminal",
            "key": "╰─",
            "keyColor": "yellow",
            "format": "{pretty-name} {version} {#36} {#35} {#34} {#33} {#32} {#37} {#90} {#31} {#30} "
        },
    ]
}
